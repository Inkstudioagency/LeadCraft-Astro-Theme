---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048be"
  title="Contact V3 || Consulting Website Astro Theme"
  description="Leadcraft is a premium Business Consulting Astro theme for consultants, agencies, and advisors to showcase services and generate leads."
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s]"
>
    <main class="main-wrapper">
      <section class="section_breadcrumb">
        <div class="hero-gap v3">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="breadcrumb-wrapper">
              <div class="breadcrumb-content-block">
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-1 title-animation"><span class="heading-style-1-main">Let&#x27;s Start a</span> <span class="heading-style-1-ht">Conversation</span></h1>
                </div>
                <div to-top-2s="" class="breadcrumb-summary-block right-align">
                  <p class="text-size-regular text-color-white">Whether you&#x27;re scaling your business, strengthening leadership, or looking for strategic clarity we’re here to help you take the next step with confidence.</p>
                  <div class="overflow-hidden right-padding">
                    <div class="heading-style-1-ht lg">Contact</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="breadcrumb-bg-block"><img src="/images/breadcrumb-bg-dot.svg" loading="lazy" alt="breadcrumb-bg-dot" class="breadcrumb-bg-dot"><img src="/images/breadcrumb-bg-noise.svg" loading="lazy" alt="breadcrumb-bg-noise" class="breadcrumb-bg-noise"><img src="/images/Contact-Hero-BG-Image.webp" loading="lazy" sizes="(max-width: 1439px) 100vw, 1440px" srcset="/images/Contact-Hero-BG-Image-p-500.webp 500w, /images/Contact-Hero-BG-Image-p-800.webp 800w, /images/Contact-Hero-BG-Image-p-1080.webp 1080w, /images/Contact-Hero-BG-Image.webp 1440w" alt="breadcrumb-bg-image" class="breadcrumb-bg-image"></div>
      </section>
      <section class="section_contact">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-fluid w-container">
            <div class="contact-wrapper">
              <div class="contact-content-block-v3">
                <div to-top-2="" class="contact-form-block-v3 w-form">
                  <form id="email-form" name="email-form" data-name="Email Form" method="get" class="contact-form-inner-block" data-wf-page-id="6a84225ef14a6cfa777048be" data-wf-element-id="5ee68da3-61db-b301-a265-584cc333d0ca">
                    <div class="contact-form-content-block">
                      <div class="contact-form-title-block">
                        <h2 class="heading-style-4">Get in touch with us</h2>
                      </div>
                      <div class="contact-form-field-block"><input class="form-text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Name *" type="text" id="name" required=""><input class="form-text-field w-input" maxlength="256" name="E-mail" data-name="E-mail" placeholder="E-mail *" type="email" id="E-mail" required=""><select id="Service" name="Service" data-name="Service" required="" class="form-text-field select w-select">
                          <option value="">Service</option>
                          <option value="First">First choice</option>
                          <option value="Second">Second choice</option>
                          <option value="Third">Third choice</option>
                        </select><textarea placeholder="Message (Tell us about your business)" maxlength="5000" id="Message" name="Message" data-name="Message" class="form-text-field large w-input"></textarea></div>
                      <div class="contact-form-button-block"><input type="submit" data-wait="Please wait..." class="form-button w-button" value="Get in touch"></div>
                    </div>
                  </form>
                  <div class="succe w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
                <div class="contact-info-block-v3">
                  <div to-top-0="" class="contact-single-info-block-v3">
                    <div class="contact-info-icon-block-v3"><img src="/images/call-02.svg" loading="lazy" alt="contact-info-icon" class="contact-info-icon"></div>
                    <div class="contact-info-text-block-v3">
                      <div class="text-size-small">Phone</div>
                      <a href="tel:(510)895-6500" class="contact-info-link-v3">(510) 895-6500</a>
                    </div>
                  </div>
                  <div to-top-2="" class="contact-single-info-block-v3">
                    <div class="contact-info-icon-block-v3"><img src="/images/mail-02.svg" loading="lazy" alt="contact-info-icon" class="contact-info-icon"></div>
                    <div class="contact-info-text-block-v3">
                      <div class="text-size-small">Email</div>
                      <a href="mailto:hello@example.com" class="contact-info-link-v3">hello@example.com</a>
                    </div>
                  </div>
                  <div to-top-4="" class="contact-single-info-block-v3">
                    <div class="contact-info-icon-block-v3"><img src="/images/location-06.svg" loading="lazy" alt="contact-info-icon" class="contact-info-icon"></div>
                    <div class="contact-info-text-block-v3">
                      <div class="text-size-small">Address</div>
                      <a href="https://example.com/location" target="_blank" class="contact-info-link-v3">USA 125 Park Avenue<br>United States, CA 83648-963</a>
                    </div>
                  </div>
                </div>
              </div>
              <div data-wf--logo-marquee--variant="v3" class="logo-content-block">
                <div to-top-0="" class="logo-title-block">
                  <div class="text-size-small text-align-center text-color-white">Brands we worked with</div>
                </div>
                <div to-top-2="" class="logo-content-inner">
                  <div class="logo-row-block">
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-6.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-2.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-1.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-3.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-4.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-3.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-1.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-7.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-1.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-2.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-4.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-2.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-4.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-5.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-4.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-3.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-5.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-1.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-2.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-5.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-7.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-1.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-6.svg" alt="logo" class="logo"></div>
                  </div>
                  <div class="logo-overlay-block w-variant-15f7edf3-f119-f8ad-7531-ff755fd643d4"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section data-wf-component-id="2296c4a0-5e91-b238-bd38-ff1de7a8a0b6" data-wf-variant-state="base" class="section_faq">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="faq-wrapper">
              <div class="faq-heading-block">
                <div class="section-heading-block align-left">
                  <div to-top-0="" class="section-subtitle-block bottom-space-lg">
                    <div class="subtitle-dot"></div>
                    <div class="subtitle-text">FAQ</div>
                  </div>
                  <div class="section-title-block max-width-35">
                    <h2 class="heading-style-2">Everything You Need to Know</h2>
                  </div>
                  <div to-top-4="" class="section-button-block top-space-lg">
                    <a href="#" class="link-button w-inline-block">
                      <div class="link-button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M16 12.083L12 15.833V8.33301L16 12.083Z" fill="currentColor"></path>
                          <path d="M2 11.333H12V12.833H2V11.333Z" fill="currentColor"></path>
                          <path d="M3.5 2.33301V12.333H2V2.33301H3.5Z" fill="currentColor"></path>
                        </svg></div>
                      <div class="link-button-text">Book a Free Call</div>
                    </a>
                  </div>
                </div>
              </div>
              <div class="faq-content-block">
                <div to-top-4="" class="faq-dropdown-block">
                  <div class="faq-dropdown-question-block">
                    <h3 class="heading-style-6">How is your coaching different from other business coaches?</h3>
                    <div class="faq-dropdown-icon-block">
                      <div class="faq-icon-line"></div>
                      <div class="faq-icon-line is-2"></div>
                    </div>
                  </div>
                  <div class="faq-dropdown-ans-block">
                    <div class="faq-dropdown-ans-inner">
                      <p class="text-size-regular">We don&#x27;t do generic advice. Every engagement is built around your specific goals, challenges, and industry. Our approach combines executive-level strategy with hands-on implementation support</p>
                    </div>
                  </div>
                </div>
                <div to-top-4="" class="faq-dropdown-block">
                  <div class="faq-dropdown-question-block">
                    <h3 class="heading-style-6">How long does it take to see results?</h3>
                    <div class="faq-dropdown-icon-block">
                      <div class="faq-icon-line"></div>
                      <div class="faq-icon-line is-2"></div>
                    </div>
                  </div>
                  <div class="faq-dropdown-ans-block">
                    <div class="faq-dropdown-ans-inner">
                      <p class="text-size-regular">Most clients begin seeing measurable shifts within the first 30–60 days — clearer direction, stronger team alignment, and sharper decision-making. Significant revenue and growth results.</p>
                    </div>
                  </div>
                </div>
                <div to-top-4="" class="faq-dropdown-block">
                  <div class="faq-dropdown-question-block">
                    <h3 class="heading-style-6">What does the coaching process look like?</h3>
                    <div class="faq-dropdown-icon-block">
                      <div class="faq-icon-line"></div>
                      <div class="faq-icon-line is-2"></div>
                    </div>
                  </div>
                  <div class="faq-dropdown-ans-block">
                    <div class="faq-dropdown-ans-inner">
                      <p class="text-size-regular">We start with a deep-dive discovery session to understand your business, goals, and gaps. From there, we build a customized growth roadmap.</p>
                    </div>
                  </div>
                </div>
                <div to-top-4="" class="faq-dropdown-block">
                  <div class="faq-dropdown-question-block">
                    <h3 class="heading-style-6">Do you offer group coaching or only 1-on-1?</h3>
                    <div class="faq-dropdown-icon-block">
                      <div class="faq-icon-line"></div>
                      <div class="faq-icon-line is-2"></div>
                    </div>
                  </div>
                  <div class="faq-dropdown-ans-block">
                    <div class="faq-dropdown-ans-inner">
                      <p class="text-size-regular">We offer both. Our 1-on-1 Executive Coaching is ideal for leaders who want personalized attention, while our Team Performance Coaching.</p>
                    </div>
                  </div>
                </div>
                <div to-top-4="" class="faq-dropdown-block">
                  <div class="faq-dropdown-question-block">
                    <h3 class="heading-style-6">What industries do your frameworks apply to?</h3>
                    <div class="faq-dropdown-icon-block">
                      <div class="faq-icon-line"></div>
                      <div class="faq-icon-line is-2"></div>
                    </div>
                  </div>
                  <div class="faq-dropdown-ans-block">
                    <div class="faq-dropdown-ans-inner">
                      <p class="text-size-regular">Our methodologies have been applied across 13,000+ hours of industry experience — spanning tech, e-commerce, professional services, real estate.</p>
                    </div>
                  </div>
                </div>
                <div to-top-4="" class="faq-dropdown-block">
                  <div class="faq-dropdown-question-block">
                    <h3 class="heading-style-6">How much does coaching cost?</h3>
                    <div class="faq-dropdown-icon-block">
                      <div class="faq-icon-line"></div>
                      <div class="faq-icon-line is-2"></div>
                    </div>
                  </div>
                  <div class="faq-dropdown-ans-block">
                    <div class="faq-dropdown-ans-inner">
                      <p class="text-size-regular">Investment varies depending on the program and level of engagement. We believe in transparent pricing and will walk you through all options during your discovery call.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section data-wf-component-id="53cb5297-990c-9364-7ad8-fd5810eb3b02" data-wf-variant-state="base" class="section_cta">
        <div class="cta-inner-block">
          <div class="cta-bg-block">
            <div class="section-gap">
              <div class="w-layout-blockcontainer container-main w-container">
                <div class="cta-wrapper">
                  <div class="cta-cotnent-block">
                    <div class="cta-title-block">
                      <div class="overflow-hidden">
                        <h2 class="cta-title is-1">Let’s Start Your </h2>
                      </div>
                      <div class="overflow-hidden">
                        <h2 class="cta-title is-2">Growth <em class="heading-style-1-ht">Journey</em></h2>
                      </div>
                    </div>
                    <div class="section-summary-block display-none">
                      <p class="text-size-large text-align-middle text-color-white-8">Consulting that translates innovation into outcomes.</p>
                    </div>
                    <div class="overflow-hidden">
                      <div class="cta-button-block">
                        <a href="/contact-v1" data-wf--white-button--variant="main-size" data-wf-component-id="7f51300f-9481-7764-372f-282224688a1e" data-wf-variant-state="base" class="white-button w-inline-block">
                          <div class="button-dot-block dark"></div>
                          <div class="button-text-block">
                            <div class="button-text">Contact Us</div>
                          </div>
                        </a>
                        <a href="#" class="link-button w-inline-block">
                          <div class="link-button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M16 12.083L12 15.833V8.33301L16 12.083Z" fill="currentColor"></path>
                              <path d="M2 11.333H12V12.833H2V11.333Z" fill="currentColor"></path>
                              <path d="M3.5 2.33301V12.333H2V2.33301H3.5Z" fill="currentColor"></path>
                            </svg></div>
                          <div class="link-button-text">Get consulting</div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
