  title="About V1 || Consulting Website Astro Theme"
  description="Leadcraft is a premium Business Consulting Astro theme for consultants, agencies, and advisors to showcase services and generate leads."
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s], .our-journey-card-block.is-5, .our-journey-card-block.is-4, .our-journey-card-block.is-3, .our-journey-card-block.is-2, .our-journey-card-block.is-1"
