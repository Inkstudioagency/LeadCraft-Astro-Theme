                        <a aria-label="single-social-block-v2" href="https://x.com/" target="_blank" class="single-social-block-v2 w-inline-block">
                          <div class="contact-social-icon w-embed"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
