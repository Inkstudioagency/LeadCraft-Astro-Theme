                              <path d="M4.00001 6H1.33334V14H4.00001V6Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                              <path d="M2.66668 3.99967C3.40306 3.99967 4.00001 3.40272 4.00001 2.66634C4.00001 1.92996 3.40306 1.33301 2.66668 1.33301C1.9303 1.33301 1.33334 1.92996 1.33334 2.66634C1.33334 3.40272 1.9303 3.99967 2.66668 3.99967Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                          </div>
                        </a>
                      </div>
                    </div>
                  </div>
                  <div class="contact-mail-info-block">
                    <div class="contact-single-info-link-block">
                      <div class="contact-info-title">Email</div>
                      <a href="mailto:hello@example.com" class="contact-mail-link-v2">hello@example.com</a>
                    </div>
                    <div class="contact-single-info-link-block">
                      <div class="contact-info-title">Phone</div>
                      <a href="tel:+(555)0123-4567" class="contact-number-link-v2">+(555) 0123-4567</a>
                    </div>
                  </div>
                </div>
                <div class="contact-right-block">
                  <div class="contact-form-block-v2 w-form">
                    <form id="email-form" name="email-form" data-name="Email Form" method="get" class="contact-form-inner-block" data-wf-page-id="6a84225ef14a6cfa777048ba" data-wf-element-id="5ee68da3-61db-b301-a265-584cc333d0ca">
                      <div class="contact-form-content-block">
                        <div class="contact-form-title-block">
                          <h2 class="heading-style-4">Get in touch with us</h2>
                        </div>
                        <div class="contact-form-field-block"><input class="form-text-field w-input" maxlength="256" name="name" data-name="Name" placeholder="Name *" type="text" id="name" required=""><input class="form-text-field w-input" maxlength="256" name="E-mail" data-name="E-mail" placeholder="E-mail *" type="email" id="E-mail" required=""><select id="Service" name="Service" data-name="Service" required="" class="form-text-field select w-select">
                            <option value="">Service</option>
                            <option value="First">First choice</option>
                            <option value="Second">Second choice</option>
                            <option value="Third">Third choice</option>
                          </select><textarea placeholder="Message (Tell us about your business)" maxlength="5000" id="Message" name="Message" data-name="Message" class="form-text-field large w-input"></textarea></div>
                        <div class="contact-form-button-block"><input type="submit" data-wait="Please wait..." class="form-button w-button" value="Get in touch"></div>
                      </div>
                    </form>
                    <div class="success-message w-form-done">
                      <div>Thank you! Your submission has been received!</div>
                    </div>
                    <div class="w-form-fail">
                      <div>Oops! Something went wrong while submitting the form.</div>
                    </div>
                  </div>
                </div>
              </div>
              <div data-wf--logo-marquee--variant="v3" class="logo-content-block">
                <div to-top-0="" class="logo-title-block">
                  <div class="text-size-small text-align-center text-color-white">Brands we worked with</div>
                </div>
                <div to-top-2="" class="logo-content-inner">
                  <div class="logo-row-block">
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-6.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-2.svg" alt="logo" class="logo"></div>
