                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-4.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-5.svg" alt="logo" class="logo"></div>
                    <div class="logo-block"><img loading="lazy" src="/images/Company-logo-4.svg" alt="logo" class="logo"></div>
