---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048ba"
  title="Contact V2 || Consulting Website Astro Theme"
  description="Leadcraft is a premium Business Consulting Astro theme for consultants, agencies, and advisors to showcase services and generate leads."
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s]"
>
    <main class="main-wrapper">
      <section class="section_breadcrumb">
        <div class="hero-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="breadcrumb-wrapper">
              <div class="breadcrumb-content-block">
                <div class="breadcrumb-title-block">
                  <h1 class="heading-style-1 title-animation"><span class="heading-style-1-main">Let&#x27;s Start a</span> <span class="heading-style-1-ht">Conversation</span></h1>
                </div>
                <div to-top-2s="" class="breadcrumb-summary-block">
                  <p class="text-size-regular text-color-white">Whether you&#x27;re scaling your business, strengthening leadership, or looking for strategic clarity we’re here to help you take the next step with confidence.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="breadcrumb-bg-block"><img src="/images/breadcrumb-bg-dot.svg" loading="lazy" alt="breadcrumb-bg-dot" class="breadcrumb-bg-dot"><img src="/images/breadcrumb-bg-noise.svg" loading="lazy" alt="breadcrumb-bg-noise" class="breadcrumb-bg-noise"><img src="/images/breadcrumb-bg-image-1.webp" loading="lazy" sizes="100vw" srcset="/images/458036a4e6a730625df47bdebfba6199_breadcrumb-bg-image-1-p-500.webp 500w, /images/458036a4e6a730625df47bdebfba6199_breadcrumb-bg-image-1-p-800.webp 800w, /images/458036a4e6a730625df47bdebfba6199_breadcrumb-bg-image-1-p-1080.webp 1080w, /images/breadcrumb-bg-image-1.webp 1440w" alt="breadcrumb-bg-image" class="breadcrumb-bg-image"></div>
      </section>
