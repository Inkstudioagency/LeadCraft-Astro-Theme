                              <path d="M12 1.33301H10C9.11597 1.33301 8.26812 1.6842 7.643 2.30932C7.01788 2.93444 6.66669 3.78229 6.66669 4.66634V6.66634H4.66669V9.33301H6.66669V14.6663H9.33335V9.33301H11.3334L12 6.66634H9.33335V4.66634C9.33335 4.48953 9.40359 4.31996 9.52862 4.19494C9.65364 4.06991 9.82321 3.99967 10 3.99967H12V1.33301Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                          </div>
                        </a>
                        <a aria-label="single-social-block-v2" href="https://x.com/" target="_blank" class="single-social-block-v2 w-inline-block">
                          <div class="contact-social-icon w-embed"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M2 14L7.03226 8.96774M14 2L8.96774 7.03226M7.03226 8.96774L10.6667 14H14L8.96774 7.03226L5.33333 2H2L7.03226 8.96774Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
