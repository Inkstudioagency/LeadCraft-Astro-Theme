---
import BaseLayout from '../layouts/BaseLayout.astro';
import jsonLd from '../data/jsonld/preview.json';
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048a2"
  title="LeadCraft - Consulting Website Astro Theme"
  description="Leadcraft is a premium Business Consulting Astro theme for consultants, agencies, and advisors to showcase services and generate leads."
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s], .preview-pages-card-block, .preview-cta-image-row.left, .preview-cta-image-row.right"
  jsonLd={jsonLd}
>
    <main class="main-wrapper">
      <section class="section_preview-hero">
        <div class="preview-hero-gap">
          <div class="w-layout-blockcontainer container-fluid w-container">
            <div class="preview-hero-wrapper">
              <div class="preview-hero-heading-block">
                <div to-top-0s="" class="preview-hero-title-block">
                  <h1 class="preview-hero-title">LeadCraft Consulting Website Theme</h1>
                </div>
                <div to-top-2s="" class="preview-hero-summary-block">
                  <p class="preview-hero-summary">A modern consulting website theme for businesses and professional service providers.</p>
                </div>
                <div to-top-4s="" class="preview-hero-button-block">
                  <a href="/home-v1" data-wf--primary-button--variant="varient-2" data-wf-component-id="004977be-65b2-b2cc-9e77-75ec7af4b400" data-wf-variant-state="da44c755-45bb-49fc-0d15-b71ef65b9fde" class="primary-button w-variant-da44c755-45bb-49fc-0d15-b71ef65b9fde w-inline-block">
                    <div class="button-dot-block w-variant-da44c755-45bb-49fc-0d15-b71ef65b9fde"></div>
                    <div class="button-text-block">
                      <div class="button-text is-1">Go To Home</div>
                    </div>
                    <div class="button-icon-block w-variant-da44c755-45bb-49fc-0d15-b71ef65b9fde">
                      <div class="button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12.083 16L15.833 12L8.33301 12L12.083 16Z" fill="currentColor"></path>
                          <path d="M11.333 2L11.333 12L12.833 12L12.833 2L11.333 2Z" fill="currentColor"></path>
                          <path d="M2.33301 3.5L12.333 3.5L12.333 2L2.33301 2L2.33301 3.5Z" fill="currentColor"></path>
                        </svg>
                      </div>
                    </div>
