                </div>
              </div>
              <div class="preview-info-content-block">
                <div class="preview-info-top-block">
                  <div to-top-2="" class="preview-info-sm-card-block">
                    <div class="preview-info-sm-card-image-block"><img src="/images/preview-info-sm-card-image.webp" loading="lazy" alt="Collage of webpage sections showing team photos, stats, client logos, and coaching details on dark backgrounds." class="preview-info-sm-card-image"></div>
                    <div class="preview-info-sm-card-text-block">
