                  <div class="preview-hero-image-block"><img src="/images/Background-1.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-2.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-3.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-8.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-5.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-6.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-7.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-10.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                  <div class="preview-hero-image-block"><img src="/images/Background-9.webp" loading="lazy" alt="preview-hero-image" class="preview-hero-image"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-bg-block bg-color"><img src="/images/Hero-BG-Noise-1.svg" loading="lazy" alt="Hero BG Noise " class="hero-bg-noise"><img src="/images/Hero-BG-Dot.svg" loading="lazy" alt="hero-bg-dot" class="hero-bg-dot"></div>
      </section>
      <section class="section_preview-info">
        <div class="preview-info-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="preview-info-wrapper">
              <div class="preview-info-heading-block">
                <div to-top-0="" class="preview-info-title-block">
                  <h2 class="heading-style-2 text-align-center text-color-primary-900">What is included in LeadCraft Template</h2>
                </div>
