                      <div class="preview-info-lg-card-text-block">
                        <h3 class="heading-style-4 text-color-primary-900 mobile-sm">Figma file included</h3>
                        <p class="text-size-regular text-color-gray-600">Send us an email to support@Inks.studio.com with your purchase receipt, and we will send you the editable Figma file for the LeadCraft template.</p>
                      </div>
                      <div class="preview-info-lg-card-button-block">
                        <a href="https://example.com/contact" data-wf--border-button--variant="without-bg" data-wf-component-id="1fed733f-e6f5-13fa-ad04-a317dd53e04f" data-wf-variant-state="base" target="_blank" class="tirtiary-button w-inline-block">
                          <div class="button-text-block">
                            <div class="button-text is-1">Request figma file</div>
                            <div class="button-text is-2">Request figma file</div>
                          </div>
                          <div class="button-icon-block show">
                            <div class="button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.083 16L15.833 12L8.33301 12L12.083 16Z" fill="currentColor"></path>
                                <path d="M11.333 2L11.333 12L12.833 12L12.833 2L11.333 2Z" fill="currentColor"></path>
                                <path d="M2.33301 3.5L12.333 3.5L12.333 2L2.33301 2L2.33301 3.5Z" fill="currentColor"></path>
                              </svg>
                            </div>
                          </div>
                        </a>
                      </div>
                    </div>
                    <div class="preview-info-lg-card-image-block"><img src="/images/preview-info-lg-card-image.webp" loading="lazy" alt="Web design UI showing a workspace with pages and multiple webpage mockups in a design app." class="preview-info-lg-card-image"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section_preview-pages">
