---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCaseStudies, getServices, related, type CaseStudy } from '../../lib/content';
import limits from '../../config/collections.json';

export async function getStaticPaths() {
  const [caseStudies, services] = await Promise.all([getCaseStudies(), getServices()]);
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: {
      study,
      relatedStudies: related(caseStudies, study.slug, limits.related.caseStudies),
      serviceName: services.find((service) => service.slug === study.services)?.title ?? study.services,
    },
  }));
}

interface Props {
  study: CaseStudy;
  relatedStudies: CaseStudy[];
  serviceName: string;
}

const { study, relatedStudies, serviceName } = Astro.props;
const impact = [study.impactStatOne, study.impactStatTwo, study.impactStatThree];
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048b2"
  title={`${study.title} || Consulting Website Astro Theme`}
  description={`${study.company} — ${study.primaryFocus}`}
  ogImage={study.bannerImage}
  ogType="article"
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s]"
>
    <main class="main-wrapper">
      <section class="section_hero regular">
        <div class="hero-gap xsm">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="case-study-hero-wrapper">
              <div class="case-study-hero-title-block">
                <div details-page-title="" class="case-study-hero-title-block details-page-title w-richtext" set:html={study.detailsTitle}></div>
              </div>
              <div to-top-4s="" class="case-study-hero-image-block"><img src="/images/service-details-hero-image-overly.svg" loading="lazy" alt="service-details-hero-image-overly" class="case-study-hero-image-overlay"><img src={study.bannerImage} loading="lazy" alt={study.title} class="case-study-hero-image"></div>
              <div class="case-study-hero-info-block">
                <div to-top-0="" class="case-study-single-info-block">
                  <div class="heading-style-6">Primary Focus</div>
                  <p class="text-size-regular text-color-gray-300">{study.primaryFocus}</p>
                </div>
                <div to-top-2="" class="case-study-single-info-block">
                  <div class="heading-style-6">Services</div>
                  <p class="text-size-regular text-color-gray-300">{serviceName}</p>
                </div>
                <div to-top-4="" class="case-study-single-info-block">
                  <div class="heading-style-6">Team Size</div>
                  <p class="text-size-regular text-color-gray-300">{study.teamSize}</p>
                </div>
                <div to-top-6="" class="case-study-single-info-block">
                  <div class="heading-style-6">Company</div>
                  <p class="text-size-regular text-color-gray-300">{study.company}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="hero-bg-block bg-color"><img src="/images/Hero-BG-Noise-1.svg" loading="lazy" alt="Hero BG Noise " class="hero-bg-noise"><img src="/images/Hero-BG-Dot.svg" loading="lazy" alt="Hero BG Dot" class="hero-bg-dot"></div>
      </section>
      <section class="section_case-study-details">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="case-study-details-wrapper">
              <div to-top-2="" class="case-study-details-text-block">
                <div class="case-study-rich-text w-richtext" set:html={study.detailsText}></div>
              </div>
              <div class="case-study-details-stats-block">
                <div to-top-0="" class="case-study-stats-title-block">
                  <h3 class="heading-style-4">Outcome and Business Impact</h3>
                </div>
                <div class="case-study-stats-content-block">
                  <div to-top-2="" class="case-study-stats-single-content-block">
                    {impact.map((stat) => (
                    <div class="case-study-stat-text _wf-counter w-richtext" set:html={stat}></div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section_case-study">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="case-study-wrapper">
              <div class="section-heading-block space-btwn">
                <div class="section-heading-text-block">
                  <div to-top-0="" class="section-subtitle-block bottom-space">
                    <div class="subtitle-dot"></div>
                    <div class="subtitle-text">Case Study</div>
                  </div>
                  <div class="section-title-block max-width-35">
                    <h2 class="heading-style-2">Read More Case Studies</h2>
                  </div>
                </div>
                <div to-top-4="" class="section-button-block">
                  <a href="/case-studies" class="link-button w-inline-block">
                    <div class="link-button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 12.083L12 15.833V8.33301L16 12.083Z" fill="currentColor"></path>
                        <path d="M2 11.333H12V12.833H2V11.333Z" fill="currentColor"></path>
                        <path d="M3.5 2.33301V12.333H2V2.33301H3.5Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="link-button-text">View case studies</div>
                  </a>
                </div>
              </div>
              <div to-top-4="" class="case-study-content-block fill">
                <div class="case-study-collection-block w-dyn-list">
                  <div role="list" class="case-study-collection-list is-horizontal w-dyn-items">
                    {relatedStudies.map((item) => (
                    <div role="listitem" class="case-study-collection-item w-dyn-item">
                      <div class="case-study-card-item-block">
                        <div class="case-study-card-image-block is-relative"><img src="/images/Team-Image-Overlay.svg" loading="lazy" alt="Team Image Overlay" class="case-study-card-image-overlay"><img src={item.thumbnail} loading="lazy" alt="case-study-card-image" class="case-study-card-image fixed"></div>
                        <div class="case-study-card-content-block sm">
                          <div class="case-study-card-text-block v2">
                            <div class="case-study-card-title-block">
                              <div class="heading-style-4">{item.title}</div>
                            </div>
                            <div class="case-study-card-button-block">
                              <a href={`/case-studies/${item.slug}`} data-wf--white-button--variant="main-size" data-wf-component-id="7f51300f-9481-7764-372f-282224688a1e" data-wf-variant-state="base" class="white-button w-inline-block">
                                <div class="button-dot-block dark"></div>
                                <div class="button-text-block">
                                  <div class="button-text">View case study</div>
                                </div>
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    ))}
                  </div>
                  {relatedStudies.length === 0 && (
                  <div class="w-dyn-empty">
                    <div>No items found.</div>
                  </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
