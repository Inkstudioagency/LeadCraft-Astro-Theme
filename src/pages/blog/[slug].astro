---
import BlogCard from '../../components/cards/BlogCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getBlogs, related, type Blog } from '../../lib/content';
import limits from '../../config/collections.json';

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((post) => ({
    params: { slug: post.slug },
    props: { post, relatedPosts: related(blogs, post.slug, limits.related.blogs) },
  }));
}

interface Props {
  post: Blog;
  relatedPosts: Blog[];
}

const { post, relatedPosts } = Astro.props;
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048b3"
  title={`${post.title} || Consulting Website Astro Theme`}
  description={post.title}
  ogImage={post.bannerImage}
  ogType="article"
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s]"
>
    <div class="main-wrapper">
      <section class="section_hero regular">
        <div class="hero-gap sm">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="blog-details-hero-wrapper">
              <div class="blog-details-hero-content-block">
                <div class="blog-details-hero-title-block">
                  <div details-page-title="" class="blog-details-hero-title w-richtext" set:html={post.detailsTitle}></div>
                </div>
                <div class="blog-details-hero-info-block">
                  <div to-top-2s="" class="blog-details-single-info-block">
                    <div class="blog-details-info-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="white" stroke-width="1.5"></path>
                        <path d="M9.5 9.5L12.9999 12.9996M16 8L11 13" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </div>
                    <p class="text-size-regular text-color-white">{post.readTime}</p>
                  </div>
                  <div to-top-2s="" class="blog-details-single-info-block">
                    <div class="blog-details-info-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 2V6M8 2V6" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M13 4H11C7.22876 4 5.34315 4 4.17157 5.17157C3 6.34315 3 8.22876 3 12V14C3 17.7712 3 19.6569 4.17157 20.8284C5.34315 22 7.22876 22 11 22H13C16.7712 22 18.6569 22 19.8284 20.8284C21 19.6569 21 17.7712 21 14V12C21 8.22876 21 6.34315 19.8284 5.17157C18.6569 4 16.7712 4 13 4Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M3 10H21" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </div>
                    <p class="text-size-regular text-color-white">{formatDate(post.publishedAt)}</p>
                  </div>
                </div>
              </div>
              <div to-top-4s="" class="blog-details-hero-image-block"><img src={post.bannerImage} loading="lazy" alt={post.title} class="blog-details-hero-image"></div>
            </div>
          </div>
        </div>
        <div class="hero-bg-block bg-color"><img src="/images/Hero-BG-Noise-1.svg" loading="lazy" alt="Hero BG Noise " class="hero-bg-noise"><img src="/images/Hero-BG-Dot.svg" loading="lazy" alt="Hero BG Dot" class="hero-bg-dot"></div>
      </section>
      <section class="section_blog-details">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="blog-details-wrapper">
              <div to-top-0="" class="blog-details-cta-block">
                <div class="blog-details-cta-form w-form">
                  <form id="email-form" name="email-form" data-name="Email Form" method="get" class="blog-details-cta-form-inner" data-wf-page-id="6a84225ef14a6cfa777048b3" data-wf-element-id="6ac5df28-80d1-0ec7-35e5-e9d3af97f28a">
                    <div class="blog-details-cta-form-content">
                      <div class="blog-details-cta-form-title-block">
                        <h2 class="blog-details-cta-form-title">Get Weekly Growth Insights to Your Inbox</h2>
                      </div>
                      <div class="blog-details-cta-form-field-block"><input class="blog-details-cta-form-field w-input" maxlength="256" name="Email" data-name="Email" placeholder="Enter your email" type="email" id="Email" required=""><input type="submit" data-wait="Please wait..." class="blog-details-cta-form-button w-button" value="Subscribe"></div>
                    </div>
                  </form>
                  <div class="success-message w-form-done">
                    <div>Thank you! Your submission has been received!</div>
                  </div>
                  <div class="w-form-fail">
                    <div>Oops! Something went wrong while submitting the form.</div>
                  </div>
                </div>
              </div>
              <div to-top-2="" class="blog-details-content-block">
                <div class="blog-details-text w-richtext" set:html={post.detailsText}></div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section_blog bg-color">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="blog-wrapper">
              <div class="section-heading-block align-left">
                <div to-top-0="" class="section-subtitle-block bottom-space">
                  <div class="subtitle-dot"></div>
                  <div class="subtitle-text">Blogs</div>
                </div>
                <div class="section-title-block max-width-25">
                  <h2 class="heading-style-2 text-align-center">Related Blog Posts</h2>
                </div>
              </div>
              <div class="blog-content-block">
                <div class="blog-collection-block w-dyn-list">
                  <div role="list" class="blog-collection-list w-dyn-items">
                    {relatedPosts.map((item) => (
                    <div role="listitem" class="blog-collection-item w-dyn-item">
                      <BlogCard post={item} animate="to-top-4" titleHover />
                    </div>
                    ))}
                  </div>
                  {relatedPosts.length === 0 && (
                  <div class="w-dyn-empty">
                    <div>No items found.</div>
                  </div>
                  )}
                </div>
                <div class="section-bottom-block left-align">
                  <div class="section-bottom-text-block">
                    <p class="text-size-regular text-color-white-800">Explore more news and insight</p>
                  </div>
                  <a href="/blog" class="link-button w-inline-block">
                    <div class="link-button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 12.083L12 15.833V8.33301L16 12.083Z" fill="currentColor"></path>
                        <path d="M2 11.333H12V12.833H2V11.333Z" fill="currentColor"></path>
                        <path d="M3.5 2.33301V12.333H2V2.33301H3.5Z" fill="currentColor"></path>
                      </svg></div>
                    <div class="link-button-text">Visit Journal</div>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
</BaseLayout>
