---
import BlogCard from '../../components/cards/BlogCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogCategories, getBlogs } from '../../lib/content';

const posts = await getBlogs();
const tabs = [
  { label: 'All', posts },
  ...blogCategories(posts).map((category) => ({
    label: category,
    posts: posts.filter((post) => post.category === category),
  })),
];
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048b5"
  title="Blog || Consulting Website Astro Theme"
  description="Leadcraft is a premium Business Consulting Astro theme for consultants, agencies, and advisors to showcase services and generate leads."
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s]"
>
    <main class="main-wrapper">
      <section class="section_breadcrumb">
        <div class="hero-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="breadcrumb-wrapper">
              <div class="breadcrumb-content-block">
                <div class="breadcrumb-title-block max-width-34">
                  <h1 class="heading-style-1 title-animation"><span class="heading-style-1-main">Our News</span> <span class="heading-style-1-ht">and Insight.</span></h1>
                </div>
                <div to-top-2s="" class="breadcrumb-summary-block max-width-22">
                  <p class="text-size-regular text-color-white">Insights, strategies, and real-world frameworks to help you lead boldly, grow faster, and build a business that lasts.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="breadcrumb-bg-block"><img src="/images/breadcrumb-bg-dot.svg" loading="lazy" alt="breadcrumb-bg-dot" class="breadcrumb-bg-dot"><img src="/images/breadcrumb-bg-noise.svg" loading="lazy" alt="breadcrumb-bg-noise" class="breadcrumb-bg-noise"><img src="/images/Portfolio-Hero-BG_1Portfolio-Hero-BG.webp" loading="lazy" sizes="100vw" srcset="/images/Portfolio-Hero-BG_1-p-500.webp 500w, /images/Portfolio-Hero-BG_1-p-800.webp 800w, /images/Portfolio-Hero-BG_1-p-1080.webp 1080w, /images/Portfolio-Hero-BG_1Portfolio-Hero-BG.webp 1440w" alt="breadcrumb-bg-image" class="breadcrumb-bg-image"></div>
      </section>
      <section class="section_blog">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="blog-wrapper">
              <div class="blog-content-block">
                <div data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="blog-tab-block w-tabs">
                  <div to-top-0="" class="blog-tab-menu w-tab-menu">
                    {tabs.map((tab, index) => (
                    <a data-w-tab={`Tab ${index + 1}`} class={index === 0 ? 'blog-tab-link w-inline-block w-tab-link w--current' : 'blog-tab-link w-inline-block w-tab-link'}>
                      <div class="blog-tab-link-icon w-embed"><svg width="8" height="8" viewBox="0 0 8 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect width="8" height="8" fill="currentColor"></rect>
                        </svg>
                      </div>
                      <div class="blog-tab-link-text">{tab.label}</div>
                    </a>
                    ))}
                  </div>
                  <div class="blog-tab-content w-tab-content">
                    {tabs.map((tab, index) => (
                    <div data-w-tab={`Tab ${index + 1}`} class={index === 0 ? 'blog-tab-pane w-tab-pane w--tab-active' : 'blog-tab-pane w-tab-pane'}>
                      <div class="blog-collection-block w-dyn-list">
                        <div role="list" class="blog-collection-list w-dyn-items">
                          {tab.posts.map((post) => (
                          <div role="listitem" class="blog-collection-item w-dyn-item">
                            <BlogCard post={post} animate={index === 0 ? 'to-top-2' : undefined} titleHover={index === 0} />
                          </div>
                          ))}
                        </div>
                        {tab.posts.length === 0 && (
                        <div class="w-dyn-empty">
                          <div>No items found.</div>
                        </div>
                        )}
                      </div>
                    </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section data-wf-component-id="53cb5297-990c-9364-7ad8-fd5810eb3b02" data-wf-variant-state="base" class="section_cta">
        <div class="cta-inner-block">
          <div class="cta-bg-block">
            <div class="section-gap">
              <div class="w-layout-blockcontainer container-main w-container">
                <div class="cta-wrapper">
                  <div class="cta-cotnent-block">
                    <div class="cta-title-block">
                      <div class="overflow-hidden">
                        <h2 class="cta-title is-1">Let’s Start Your </h2>
                      </div>
                      <div class="overflow-hidden">
                        <h2 class="cta-title is-2">Growth <em class="heading-style-1-ht">Journey</em></h2>
                      </div>
                    </div>
                    <div class="section-summary-block display-none">
                      <p class="text-size-large text-align-middle text-color-white-8">Consulting that translates innovation into outcomes.</p>
                    </div>
                    <div class="overflow-hidden">
                      <div class="cta-button-block">
                        <a href="/contact-v1" data-wf--white-button--variant="main-size" data-wf-component-id="7f51300f-9481-7764-372f-282224688a1e" data-wf-variant-state="base" class="white-button w-inline-block">
                          <div class="button-dot-block dark"></div>
                          <div class="button-text-block">
                            <div class="button-text">Contact Us</div>
                          </div>
                        </a>
                        <a href="#" class="link-button w-inline-block">
                          <div class="link-button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M16 12.083L12 15.833V8.33301L16 12.083Z" fill="currentColor"></path>
                              <path d="M2 11.333H12V12.833H2V11.333Z" fill="currentColor"></path>
                              <path d="M3.5 2.33301V12.333H2V2.33301H3.5Z" fill="currentColor"></path>
                            </svg></div>
                          <div class="link-button-text">Get consulting</div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
