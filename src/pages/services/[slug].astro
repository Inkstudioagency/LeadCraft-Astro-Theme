---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { detailsImages, getServices, related, type Service } from '../../lib/content';
import limits from '../../config/collections.json';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service, relatedServices: related(services, service.slug, limits.related.services) },
  }));
}

interface Props {
  service: Service;
  relatedServices: Service[];
}

const { service, relatedServices } = Astro.props;
const stats = [
  service.resultStatOne,
  service.resultStatTwo,
  service.resultStatThree,
  service.resultStatFour,
];
---

<BaseLayout
  wfPageId="6a84225ef14a6cfa777048b1"
  title={`${service.title} || Consulting Website Astro Theme`}
  description={service.summary}
  ogImage={service.bannerImage}
  ogType="article"
  hidden=".cta-inner-block, .cta-title.is-1, .cta-title.is-2, .cta-button-block, .link-button-icon, .blog-collection-block.is-1, .blog-collection-block.is-2, .blog-collection-block.is-3, [to-top-8], .timeline-ht-liner-block-v2, .timeline-pointer-block-v2.is-1, .timeline-pointer-block-v2.is-2, .timeline-pointer-block-v2.is-3, .timeline-pointer-block-v2.is-4, .team-cards-inner-block-v3, .team-scroll-liner-ht, .our-value-single-card-block-v3.is-1, .our-value-single-card-block-v3.is-2, .our-value-single-card-block-v3.is-3, .about-title-two, .about-title-overlay.is-1, .about-title-overlay.is-2, .about-title-overlay.is-3, .about-title-overlay.is-4, .button-text-block, .button-dot-block.dark, .footer-logo-content-block, [to-top-6], .heading-style-1-main, .heading-style-1-ht, .button-icon, [to-top-0], .button-dot-block, .heading-style-2, .faq-icon-line.is-2, [details-page-title], [to-top-4], [to-top-2], .link-dot, .link-text, [to-top-0s], [to-top-2s], [to-top-4s], [to-top-6s], [to-top-8s]"
>
    <main class="main-wrapper">
      <section class="section_hero regular">
        <div class="hero-gap sm">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="service-details-hero-wrapper">
              <div class="service-details-hero-title-block">
                <div details-page-title="" class="service-details-hero-title w-richtext" set:html={service.detailsTitle}></div>
              </div>
              <div to-top-4s="" class="service-details-hero-image-block"><img src="/images/service-details-hero-image-overly.svg" loading="lazy" alt="service-details-hero-image-overly" class="service-details-hero-image-overly"><img src={service.bannerImage} loading="lazy" alt={service.title} class="service-details-hero-image"></div>
            </div>
          </div>
        </div>
        <div class="hero-bg-block bg-color"><img src="/images/Hero-BG-Noise-1.svg" loading="lazy" alt="Hero BG Noise " class="hero-bg-noise"><img src="/images/Hero-BG-Dot.svg" loading="lazy" alt="Hero BG Dot" class="hero-bg-dot"></div>
      </section>
      <section class="section_service-details">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="service-details-wrapper">
              <div class="service-details-info-block">
                <div to-top-0="" class="section-subtitle-block bottom-space-lg">
                  <div class="subtitle-dot"></div>
                  <div class="subtitle-text">Service details</div>
                </div>
                <div to-top-2="" class="service-details-sticky-block">
                  <div class="service-details-cta-summary-block">
                    <div class="service-details-cta-text w-richtext" set:html={service.pricingContent}></div>
                  </div>
                  <div class="service-details-cta-button-block">
                    <a href="/contact-v1" data-wf--white-button--variant="full-width" data-wf-component-id="7f51300f-9481-7764-372f-282224688a1e" data-wf-variant-state="9c51991b-bf55-6486-9683-b51722e5ac2b" class="white-button w-variant-9c51991b-bf55-6486-9683-b51722e5ac2b w-inline-block">
                      <div class="button-dot-block dark"></div>
                      <div class="button-text-block w-variant-9c51991b-bf55-6486-9683-b51722e5ac2b">
                        <div class="button-text">Book a Free Call</div>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
              <div class="service-details-content-block">
                <div to-top-4="" class="service-details-text-block">
                  <div class="service-details-text w-richtext" set:html={service.detailsTextOne}></div>
                </div>
                <div to-top-0="" class="service-details-image-block">
                  <div class="service-details-image-collection w-dyn-list">
                    <div role="list" class="service-details-image-collection-list w-dyn-items">
                      {detailsImages(service).map((image) => (
                      <div role="listitem" class="service-details-image-collection-item w-dyn-item">
                        <div class="service-details-single-image-block"><img src={image} loading="lazy" width="70" alt={service.title} class="service-details-image"><img src="/images/service-details-hero-image-overly.svg" loading="lazy" alt="service-details-hero-image-overly" class="service-details-image-overlay"></div>
                      </div>
                      ))}
                    </div>
                    {detailsImages(service).length === 0 && (
                    <div class="w-dyn-empty">
                      <div>No items found.</div>
                    </div>
                    )}
                  </div>
                </div>
                <div to-top-0="" class="service-details-text-block">
                  <div class="service-details-text w-richtext" set:html={service.detailsTextTwo}></div>
                </div>
                <div class="service-details-stats-block">
                  <div to-top-0="" class="service-details-stats-title-block">
                    <h3 class="heading-style-4">Average Client Results</h3>
                  </div>
                  <div class="service-details-stats-card-block">
                    {stats.map((stat) => (
                    <div to-top-2="" class="service-details-single-stat-block">
                      <div class="service-details-stat-text _wf-counter w-richtext" set:html={stat}></div>
                      <div class="service-details-stat-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M17 17V7H7M17 7L7 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </div>
                    </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section_services">
        <div class="section-gap">
          <div class="w-layout-blockcontainer container-main w-container">
            <div class="services-wrapper">
              <div class="section-heading-block space-btwn">
                <div class="section-heading-text-block">
                  <div to-top-0="" class="section-subtitle-block bottom-space-lg">
                    <div class="subtitle-dot"></div>
                    <div class="subtitle-text">RELATED SERVICES</div>
                  </div>
                  <div class="section-title-block max-width-35">
                    <h2 class="heading-style-2">Complementary Services</h2>
                  </div>
                </div>
                <div class="section-button-block">
                  <a href="/services" data-wf--primary-button--variant="varient-1" data-wf-component-id="004977be-65b2-b2cc-9e77-75ec7af4b400" data-wf-variant-state="base" class="primary-button w-inline-block">
                    <div class="button-dot-block"></div>
                    <div class="button-text-block">
                      <div class="button-text is-1">All Services</div>
                    </div>
                    <div class="button-icon-block">
                      <div class="button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12.083 16L15.833 12L8.33301 12L12.083 16Z" fill="currentColor"></path>
                          <path d="M11.333 2L11.333 12L12.833 12L12.833 2L11.333 2Z" fill="currentColor"></path>
                          <path d="M2.33301 3.5L12.333 3.5L12.333 2L2.33301 2L2.33301 3.5Z" fill="currentColor"></path>
                        </svg>
                      </div>
                    </div>
                  </a>
                </div>
              </div>
              <div class="services-content-block-v2">
                <div class="services-collection-block-v2 w-dyn-list">
                  <div role="list" class="services-collection-list-v1 w-dyn-items">
                    {relatedServices.map((item) => (
                    <div role="listitem" class="services-collection-item-v1 w-dyn-item">
                      <div class="services-item-card-bloc-v1">
                        <a href={`/services/${item.slug}`} class="services-item-thumbnail-block w-inline-block"><img src="/images/Service-Image-Overlay.svg" loading="lazy" alt="Service Image Overlay" class="services-thumbnail-overlay"><img src={item.thumbnail} loading="lazy" alt={item.title} class="services-item-thumbnail-v1"></a>
                        <div class="services-item-content-block">
                          <div class="services-item-text-block">
                            <a href={`/services/${item.slug}`} class="services-item-title-block w-inline-block">
                              <h3 class="services-item-title">{item.title}</h3>
                            </a>
                            <div class="services-item-summary-block">
                              <p class="text-size-regular">{item.summary}</p>
                            </div>
                          </div>
                          <div class="services-item-button-block">
                            <a href={`/services/${item.slug}`} class="link-button w-inline-block">
                              <div class="link-button-icon w-embed"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <path d="M16 12.083L12 15.833V8.33301L16 12.083Z" fill="currentColor"></path>
                                  <path d="M2 11.333H12V12.833H2V11.333Z" fill="currentColor"></path>
                                  <path d="M3.5 2.33301V12.333H2V2.33301H3.5Z" fill="currentColor"></path>
                                </svg></div>
                              <div class="link-button-text">Learn more</div>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                    ))}
                  </div>
                  {relatedServices.length === 0 && (
                  <div class="w-dyn-empty">
                    <div>No items found.</div>
                  </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
</BaseLayout>
