                        </div>
                      </div>
                      <div class="icon-varients-block">
                        <div class="icon-varients-title-block">
                          <div class="label-large">Icon</div>
                        </div>
                        <div class="icon-varients-content-block"><img loading="lazy" src="/images/List-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/testimonial-star-icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Purpose-Card-Icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Purpose-Card-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/menu-icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Menu-Close-Icon-2.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Arrow-Icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/select-arrow-icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/location-06.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/mail-02.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/call-02.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/credentials-card-icon.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/credentials-card-icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/credentials-card-icon-3.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Purpose-Card-Icon-1.svg" alt="style-guide-icon" class="style-guide-icon"><img loading="lazy" src="/images/Purpose-Card-Icon-3.svg" alt="style-guide-icon" class="style-guide-icon"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section data-wf-component-id="53cb5297-990c-9364-7ad8-fd5810eb3b02" data-wf-variant-state="base" class="section_cta">
        <div class="cta-inner-block">
          <div class="cta-bg-block">
            <div class="section-gap">
              <div class="w-layout-blockcontainer container-main w-container">
                <div class="cta-wrapper">
                  <div class="cta-cotnent-block">
                    <div class="cta-title-block">
                      <div class="overflow-hidden">
                        <h2 class="cta-title is-1">Let’s Start Your </h2>
                      </div>
                      <div class="overflow-hidden">
                        <h2 class="cta-title is-2">Growth <em class="heading-style-1-ht">Journey</em></h2>
                      </div>
                    </div>
                    <div class="section-summary-block display-none">
                      <p class="text-size-large text-align-middle text-color-white-8">Consulting that translates innovation into outcomes.</p>
                    </div>
                    <div class="overflow-hidden">
                      <div class="cta-button-block">
