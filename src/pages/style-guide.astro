                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block bg-color-2"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold text-color-big-stone">BG Color 2</div>
                          <div class="color-code">#252525</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block bg-color-3"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold text-color-big-stone">BG Color 3</div>
                          <div class="color-code">#1a1a1a</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block primary-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold text-color-big-stone">Primary Color</div>
                          <div class="color-code">#0c5eff</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block black-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold text-color-big-stone">Black Color</div>
                          <div class="color-code">#000000</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block gray-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold text-color-big-stone">Gray Color</div>
                          <div class="color-code">#8f8f8f</div>
                        </div>
                      </div>
                      <div class="color-single-block">
                        <div class="color-block white-color"></div>
                        <div class="color-info-block">
                          <div class="label-medium text-weight-semi-bold text-color-big-stone">White Color</div>
                          <div class="color-code">#ffffff</div>
                        </div>
                      </div>
                    </div>
                  </div>
