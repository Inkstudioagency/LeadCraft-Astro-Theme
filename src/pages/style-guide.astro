                      <div class="typography-single-block">
                        <div class="typography-text-block">
                          <h4>Heading 4</h4>
                        </div>
                        <div class="typography-info-block">
                          <div class="paragraph-xsmall text-weight-medium">General Sans • Medium • 2rem • 1.3 Line Height</div>
                        </div>
                      </div>
                      <div class="typography-single-block">
                        <div class="typography-text-block">
