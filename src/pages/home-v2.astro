---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getBlogs, getCaseStudies, getServices } from '../lib/content';
import limits from '../config/collections.json';

const [homeServices, homeCaseStudies, homeBlogs] = await Promise.all([
  getServices().then((items) => items.slice(0, limits.home.services)),
  getCaseStudies().then((items) => items.slice(0, limits.home.caseStudies)),
  getBlogs().then((items) => items.slice(0, limits.home.blogs)),
]);

