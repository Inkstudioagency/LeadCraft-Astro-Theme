# Absolute URL of the deployed site. Canonical links, Open Graph tags and
# sitemap.xml are generated from it.
SITE_URL="https://example.com"

# Optional. Leave both unset to render the sample content bundled in
# `src/data/*.json`. Point STRAPI_URL at a running Strapi instance to load
# services, case studies and blog posts from the CMS instead.
# STRAPI_URL="http://localhost:1337"
# STRAPI_TOKEN=""
